# 仅限个人、回环地址上的隔离教学实验，严禁填入生产密码或真实数据。
# 首次 start 会复制到 infra/.env（已由仓库 .gitignore 排除）；请勿把它提交或分享。
# 本文件不是 shell 脚本：仅允许单行 KEY=VALUE，不写引号、$、空格或命令。
LAB_PROJECT_NAME=auto
MYSQL_PORT=13306
REDIS_PORT=16379
KAFKA_PORT=19092
ROCKETMQ_PORT=18081
MYSQL_DATABASE=interview_lab
MYSQL_USER=lab
MYSQL_PASSWORD=lab_mysql_only_2026
MYSQL_ROOT_PASSWORD=lab_root_only_2026
REDIS_PASSWORD=lab_redis_only_2026
LAB_WAIT_SECONDS=180
CAPSTONE_HTTP_PORT=8088
